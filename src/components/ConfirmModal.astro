---
---

<div id="confirm-modal-backdrop" class="fixed inset-0 z-[80] flex items-center justify-center p-6 hidden">
	<!-- Backdrop Blur -->
	<div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>
	
	<!-- Modal Content -->
	<div class="relative w-full max-w-sm clay-card bg-white flex flex-col items-center text-center gap-5 animate-zoom-in shadow-2xl z-10">
		<div id="confirm-modal-icon-box" class="h-16 w-16 flex items-center justify-center rounded-2xl border-2 border-rose-200 bg-rose-50 text-rose-500 shadow-inner">
			<svg id="confirm-modal-icon-danger" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
			<svg id="confirm-modal-icon-info" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="hidden text-brand-primary"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
		</div>

		<div class="flex flex-col gap-1.5 px-2">
			<h3 id="confirm-modal-title" class="text-2xl font-black uppercase tracking-tighter leading-none text-brand-secondary font-display">Delete Phrase?</h3>
			<p id="confirm-modal-message" class="text-xs font-semibold text-gray-500 leading-snug">Are you sure you want to delete this phrase from your collection?</p>
		</div>

		<div class="flex gap-3 w-full mt-2">
			<button id="confirm-modal-cancel-btn" class="flex-1 py-3 px-4 bg-white border-2 border-brand-outline rounded-xl font-black text-xs uppercase text-gray-500 hover:bg-gray-50 active:translate-y-[1px] cursor-pointer transition-all shadow-sm">
				Cancel
			</button>
			<button id="confirm-modal-action-btn" class="flex-1 py-3 px-4 bg-rose-500 hover:bg-rose-600 active:bg-rose-700 text-white font-black rounded-xl text-xs uppercase tracking-wider border-2 border-rose-600 shadow-[0_4px_0_0_#be123c] active:translate-y-[2px] active:shadow-none transition-all cursor-pointer">
				Delete
			</button>
		</div>
	</div>
</div>

<script>
	let currentOnConfirm: (() => void) | null = null;

	function initConfirmModal() {
		const backdrop = document.getElementById('confirm-modal-backdrop');
		const titleEl = document.getElementById('confirm-modal-title');
		const messageEl = document.getElementById('confirm-modal-message');
		const iconBox = document.getElementById('confirm-modal-icon-box');
		const iconDanger = document.getElementById('confirm-modal-icon-danger');
		const iconInfo = document.getElementById('confirm-modal-icon-info');
		const cancelBtn = document.getElementById('confirm-modal-cancel-btn');
		const actionBtn = document.getElementById('confirm-modal-action-btn');

		if (!backdrop) return;

		function hide() {
			if (backdrop) {
				backdrop.classList.add('hidden');
			}
			currentOnConfirm = null;
		}

		if (cancelBtn) {
			cancelBtn.addEventListener('click', hide);
		}

		if (actionBtn) {
			actionBtn.addEventListener('click', () => {
				if (currentOnConfirm) {
					currentOnConfirm();
				}
				hide();
			});
		}

		(window as any).showConfirmModal = (options: any = {}) => {
			const {
				title = 'Confirm Action',
				message = 'Are you sure you want to proceed?',
				confirmText = 'Confirm',
				cancelText = 'Cancel',
				isDanger = true,
				onConfirm = () => {}
			} = options;

			if (titleEl) titleEl.textContent = title;
			if (messageEl) messageEl.textContent = message;
			if (cancelBtn) cancelBtn.textContent = cancelText;
			if (actionBtn) actionBtn.textContent = confirmText;

			currentOnConfirm = onConfirm;

			if (isDanger) {
				if (iconBox) iconBox.className = 'h-16 w-16 flex items-center justify-center rounded-2xl border-2 border-rose-200 bg-rose-50 text-rose-500 shadow-inner';
				if (actionBtn) actionBtn.className = 'flex-1 py-3 px-4 bg-rose-500 hover:bg-rose-600 active:bg-rose-700 text-white font-black rounded-xl text-xs uppercase tracking-wider border-2 border-rose-600 shadow-[0_4px_0_0_#be123c] active:translate-y-[2px] active:shadow-none transition-all cursor-pointer';
				if (iconDanger) iconDanger.classList.remove('hidden');
				if (iconInfo) iconInfo.classList.add('hidden');
			} else {
				if (iconBox) iconBox.className = 'h-16 w-16 flex items-center justify-center rounded-2xl border-2 border-brand-primary/20 bg-brand-primary/10 text-brand-primary shadow-inner';
				if (actionBtn) actionBtn.className = 'flex-1 clay-btn-success py-3 px-4 text-xs uppercase tracking-wider cursor-pointer';
				if (iconDanger) iconDanger.classList.add('hidden');
				if (iconInfo) iconInfo.classList.remove('hidden');
			}

			if (backdrop) {
				backdrop.classList.remove('hidden');
			}
		};
	}

	document.addEventListener('astro:page-load', initConfirmModal);
</script>
