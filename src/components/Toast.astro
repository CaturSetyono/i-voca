---
---

<div id="toast-container" class="fixed top-6 left-1/2 -translate-x-1/2 z-[90] w-[90%] max-w-[380px] pointer-events-none flex flex-col gap-2 items-center">
	<!-- Toast Notifications rendered dynamically via JS -->
</div>

<script>
	function initToast() {
		const container = document.getElementById('toast-container');
		if (!container) return;

		(window as any).showToast = (options: any = {}) => {
			const {
				message = '',
				type = 'info',
				duration = 3200
			} = options;

			const toast = document.createElement('div');
			toast.className = 'pointer-events-auto w-full clay-card !p-3.5 flex items-center gap-3 shadow-xl animate-slide-up transition-all duration-300 transform';

			let iconSvg = `
				<div class="h-9 w-9 rounded-xl bg-blue-100 text-blue-600 border border-blue-200 flex items-center justify-center shrink-0">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
				</div>
			`;

			if (type === 'success') {
				toast.classList.add('bg-white', 'border-emerald-200');
				iconSvg = `
					<div class="h-9 w-9 rounded-xl bg-emerald-100 text-emerald-600 border border-emerald-300 flex items-center justify-center shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
					</div>
				`;
			} else if (type === 'error') {
				toast.classList.add('bg-white', 'border-rose-200');
				iconSvg = `
					<div class="h-9 w-9 rounded-xl bg-rose-100 text-rose-600 border border-rose-300 flex items-center justify-center shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
					</div>
				`;
			} else if (type === 'warning') {
				toast.classList.add('bg-white', 'border-amber-200');
				iconSvg = `
					<div class="h-9 w-9 rounded-xl bg-amber-100 text-amber-600 border border-amber-300 flex items-center justify-center shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
					</div>
				`;
			}

			toast.innerHTML = `
				${iconSvg}
				<div class="flex-1 pr-2">
					<p class="text-xs font-black text-brand-secondary leading-snug font-display">${message}</p>
				</div>
				<button class="toast-close text-gray-300 hover:text-gray-500 font-bold p-1 cursor-pointer">✕</button>
			`;

			const closeBtn = toast.querySelector('.toast-close');
			const removeToast = () => {
				toast.classList.add('opacity-0', '-translate-y-2');
				setTimeout(() => toast.remove(), 300);
			};

			if (closeBtn) {
				closeBtn.addEventListener('click', removeToast);
			}

			container.appendChild(toast);
			setTimeout(removeToast, duration);
		};
	}

	document.addEventListener('astro:page-load', initToast);
</script>
